{
  "name": "bend2-lsp",
  "version": "0.2.0",
  "description": "Language server for Bend 2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/don2e4/bend2-lsp.git"
  },
  "bugs": "https://github.com/don2e4/bend2-lsp/issues",
  "homepage": "https://github.com/don2e4/bend2-lsp#readme",
  "type": "module",
  "bin": {
    "bend2-lsp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "dependencies": {
    "vscode-languageserver": "10.1.1",
    "vscode-languageserver-textdocument": "1.0.14"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
